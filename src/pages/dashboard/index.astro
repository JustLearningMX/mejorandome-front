</style>

<script>
  import { authService } from '../../services/auth.service';
  import { dashboardService } from '../../services/dashboard.service';
  import { weightService } from '../../services/weight.service';
  import { nutritionService } from '../../services/nutrition.service';
  import { activityService } from '../../services/activity.service';
  import { showAuthNotification } from '../../utils/auth-client';
  import type { AuthenticatedUser } from '../../types/auth';
  import type { DashboardSummary } from '../../types/dashboard';
  import type { MealType } from '../../types/nutrition';
  import type { ExerciseType, ExerciseIntensity } from '../../types/activity';

  async function initializeDashboard() {
    const gateView = document.getElementById('auth-required-view');
    const dashboardView = document.getElementById('dashboard-view');

    const token = authService.getStoredToken();
    const storedUser = authService.getStoredUser();

    if (!token) {
      if (gateView) gateView.style.display = 'flex';
      if (dashboardView) dashboardView.style.display = 'none';
      return;
    }

    // Usuario autenticado
    if (gateView) gateView.style.display = 'none';
    if (dashboardView) dashboardView.style.display = 'flex';

    // 1. Renderizar perfil de usuario en el hero (Avatar con foto de Google o inicial)
    const renderUserProfile = (user: AuthenticatedUser) => {
      const nameEl = document.getElementById('view-user-name');
      const emailEl = document.getElementById('view-user-email');
      const photoEl = document.getElementById('view-user-photo') as HTMLImageElement | null;
      const initialEl = document.getElementById('view-user-avatar');

      if (nameEl && user.name) nameEl.textContent = user.name;
      if (emailEl && user.email) emailEl.textContent = user.email;

      const initial = user.name ? user.name.trim().charAt(0).toUpperCase() : 'U';
      if (initialEl) initialEl.textContent = initial;

      if (user.picture && photoEl) {
        photoEl.src = user.picture;
        photoEl.alt = user.name || 'Avatar';
        photoEl.style.display = 'block';
        if (initialEl) initialEl.style.display = 'none';

        photoEl.onerror = () => {
          photoEl.style.display = 'none';
          if (initialEl) initialEl.style.display = 'block';
        };
      } else {
        if (photoEl) photoEl.style.display = 'none';
        if (initialEl) initialEl.style.display = 'block';
      }
    };

    if (storedUser) {
      renderUserProfile(storedUser);
    }

    // 2. Renderizar métricas reales en las cards (Sin datos dummy)
    const renderMetrics = (summary: DashboardSummary) => {
      // Card 1: Peso corporal
      const pesoVal = document.getElementById('metric-peso-val');
      const pesoTag = document.getElementById('metric-peso-tag');
      const pesoTrendWrap = document.getElementById('metric-peso-trend-wrap');
      const pesoFooter = document.getElementById('metric-peso-footer');
      const pesoCtaWrap = document.getElementById('metric-peso-cta-wrap');

      if (summary.weight.hasMeasurements && summary.weight.latestKg != null) {
        if (pesoVal) {
          pesoVal.textContent = summary.weight.latestKg.toFixed(1);
          pesoVal.classList.remove('metric-empty');
        }
        if (pesoTag) pesoTag.textContent = summary.weight.latestDate || 'Último';
        if (pesoCtaWrap) pesoCtaWrap.style.display = 'none';

        if (pesoTrendWrap) {
          if (summary.weight.differenceKg != null) {
            const isDown = summary.weight.differenceKg <= 0;
            const diffFormatted = Math.abs(summary.weight.differenceKg).toFixed(1);
            pesoTrendWrap.innerHTML = `
              <span class="metric-trend ${isDown ? 'metric-trend--down' : 'metric-trend--up'}">
                ${isDown ? '↓' : '↑'} ${diffFormatted} kg respecto a la anterior
              </span>
            `;
          } else {
            pesoTrendWrap.innerHTML = '<span class="metric-empty-notice">Medición registrada hoy</span>';
          }
        }

        if (pesoFooter) {
          pesoFooter.textContent = summary.weight.monthlyAverageKg != null
            ? `Promedio del mes: ${summary.weight.monthlyAverageKg.toFixed(1)} kg`
            : 'Medición registrada';
        }
      } else {
        // Estado real: Sin mediciones registradas en la base de datos
        if (pesoVal) {
          pesoVal.textContent = '--';
          pesoVal.classList.add('metric-empty');
        }
        if (pesoTag) pesoTag.textContent = 'Sin registro';
        if (pesoCtaWrap) pesoCtaWrap.style.display = 'block';
        if (pesoTrendWrap) {
          pesoTrendWrap.innerHTML = '<span class="metric-empty-notice">Sin mediciones registradas en el historial.</span>';
        }
        if (pesoFooter) {
          pesoFooter.textContent = 'Promedio mensual: Sin datos aún';
        }
      }

      // Card 2: Actividad Física (Pasos y Ejercicio)
      const pasosVal = document.getElementById('metric-pasos-val');
      const pasosProgress = document.getElementById('metric-pasos-progress');
      const pasosGoal = document.getElementById('metric-pasos-goal');
      const ejercicioMin = document.getElementById('metric-ejercicio-min');
      const actividadFooter = document.getElementById('metric-actividad-footer');
      const activityCtaWrap = document.getElementById('metric-activity-cta-wrap');

      const hasAnyActivity = summary.activity.hasActivityToday || summary.activity.steps > 0 || summary.activity.exerciseMinutes > 0;

      if (hasAnyActivity) {
        if (pasosVal) pasosVal.textContent = summary.activity.steps.toLocaleString();
        const goal = summary.activity.stepsGoal || 10000;
        const pct = Math.min(100, Math.round((summary.activity.steps / goal) * 100));
        if (pasosProgress) pasosProgress.style.width = `${pct}%`;
        if (pasosGoal) pasosGoal.textContent = `${goal.toLocaleString()} pasos`;
        if (ejercicioMin) ejercicioMin.textContent = `${summary.activity.exerciseMinutes} min`;
        if (activityCtaWrap) activityCtaWrap.style.display = 'none';
        if (actividadFooter) {
          actividadFooter.textContent = summary.activity.weeklyAverageSteps != null
            ? `Promedio semanal: ${summary.activity.weeklyAverageSteps.toLocaleString()} pasos / día`
            : 'Actividad registrada hoy';
        }
      } else {
        // Estado real: Sin actividad registrada hoy
        if (pasosVal) pasosVal.textContent = '0';
        if (pasosProgress) pasosProgress.style.width = '0%';
        if (pasosGoal) pasosGoal.textContent = `${(summary.activity.stepsGoal || 10000).toLocaleString()} pasos`;
        if (ejercicioMin) ejercicioMin.textContent = '0 min';
        if (activityCtaWrap) activityCtaWrap.style.display = 'block';
        if (actividadFooter) actividadFooter.textContent = 'Sin actividad registrada el día de hoy';
      }

      // Card 3: Alimentación y Saciedad
      const comidasVal = document.getElementById('metric-comidas-val');
      const comidasUnit = document.getElementById('metric-comidas-unit');
      const saciedadBadge = document.getElementById('metric-saciedad-badge');
      const pausasVal = document.getElementById('metric-pausas-val');
      const repeticionVal = document.getElementById('metric-repeticion-val');
      const alimentacionFooter = document.getElementById('metric-alimentacion-footer');
      const mealCtaWrap = document.getElementById('metric-meal-cta-wrap');

      if (summary.nutrition.hasMealsToday && summary.nutrition.mealsCount > 0) {
        if (comidasVal) {
          comidasVal.textContent = String(summary.nutrition.mealsCount);
          comidasVal.classList.remove('metric-empty');
        }
        if (comidasUnit) {
          comidasUnit.textContent = summary.nutrition.mealsCount === 1 ? 'comida hoy' : 'comidas hoy';
        }
        if (mealCtaWrap) mealCtaWrap.style.display = 'none';

        if (saciedadBadge) {
          if (summary.nutrition.averageSatietyLevel != null) {
            saciedadBadge.className = 'satiety-badge';
            saciedadBadge.textContent = `Nivel ${summary.nutrition.averageSatietyLevel} — ${summary.nutrition.satietyDescription || 'Satisfecho'}`;
          } else {
            saciedadBadge.className = 'satiety-badge satiety-badge--empty';
            saciedadBadge.textContent = 'Sin nivel de saciedad registrado';
          }
        }

        if (pausasVal) {
          pausasVal.textContent = `${summary.nutrition.consciousPausesCount} de ${summary.nutrition.mealsCount}`;
        }
        if (repeticionVal) {
          repeticionVal.textContent = `${summary.nutrition.repeatedMealsCount} veces`;
        }
        if (alimentacionFooter) {
          alimentacionFooter.textContent = `${summary.nutrition.mealsCount} registro(s) completado(s) hoy`;
        }
      } else {
        // Estado real: Sin comidas registradas hoy
        if (comidasVal) {
          comidasVal.textContent = '0';
          comidasVal.classList.add('metric-empty');
        }
        if (comidasUnit) comidasUnit.textContent = 'comidas hoy';
        if (mealCtaWrap) mealCtaWrap.style.display = 'block';
        if (saciedadBadge) {
          saciedadBadge.className = 'satiety-badge satiety-badge--empty';
          saciedadBadge.textContent = 'Sin registros de saciedad hoy';
        }
        if (pausasVal) pausasVal.textContent = '0 registradas';
        if (repeticionVal) repeticionVal.textContent = '0 veces';
        if (alimentacionFooter) {
          alimentacionFooter.textContent = 'Registra tu primera comida para comenzar el seguimiento';
        }
      }
    };

    // Consultar datos reales de dashboard desde el backend
    try {
      const summary = await dashboardService.getSummary(token);
      renderMetrics(summary);
    } catch (err) {
      console.warn('Error al obtener datos reales de dashboard:', err);
    }

    // Sincronizar usuario fresco de la API
    try {
      const freshUser = await authService.getMe(token);
      renderUserProfile(freshUser);
    } catch (err) {
      console.warn('No se pudo sincronizar usuario con el backend:', err);
    }

    // 3. Modal de registro de peso
    const weightModal = document.getElementById('weight-modal') as HTMLDialogElement | null;
    const weightForm = document.getElementById('weight-form') as HTMLFormElement | null;
    const weightInput = document.getElementById('input-weight-kg') as HTMLInputElement | null;
    const dateInput = document.getElementById('input-weight-date') as HTMLInputElement | null;
    const errorBanner = document.getElementById('weight-form-error');
    const submitBtn = document.getElementById('btn-submit-weight') as HTMLButtonElement | null;
    const submitBtnText = document.getElementById('btn-submit-weight-text');

    const openWeightModal = () => {
      if (!weightModal) return;
      if (errorBanner) {
        errorBanner.style.display = 'none';
        errorBanner.textContent = '';
      }
      if (weightInput) {
        weightInput.value = '';
      }
      if (dateInput) {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        dateInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
      }
      weightModal.showModal();
      setTimeout(() => weightInput?.focus(), 50);
    };

    const closeWeightModal = () => {
      if (weightModal && weightModal.open) {
        weightModal.close();
      }
    };

    document.getElementById('action-peso')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-add-weight-card')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-card-register-peso')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-close-weight-modal')?.addEventListener('click', closeWeightModal);
    document.getElementById('btn-cancel-weight')?.addEventListener('click', closeWeightModal);

    weightModal?.addEventListener('click', (e) => {
      if (e.target === weightModal) closeWeightModal();
    });

    weightForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!weightInput) return;

      const rawVal = weightInput.value.trim();
      const weightVal = parseFloat(rawVal);

      if (isNaN(weightVal) || weightVal < 20.0 || weightVal > 350.0) {
        if (errorBanner) {
          errorBanner.textContent = 'Por favor introduce un peso válido entre 20.0 y 350.0 kg.';
          errorBanner.style.display = 'block';
        }
        weightInput.focus();
        return;
      }

      let occurredAt: string | undefined = undefined;
      if (dateInput && dateInput.value) {
        try {
          const parsedDate = new Date(dateInput.value);
          if (!isNaN(parsedDate.getTime())) {
            occurredAt = parsedDate.toISOString();
          }
        } catch {
          // Dejar undefined para que el backend asigne 'now'
        }
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Guardando...';
      if (errorBanner) errorBanner.style.display = 'none';

      try {
        await weightService.createWeight(
          {
            weightKg: Math.round(weightVal * 100) / 100,
            occurredAt,
          },
          token
        );

        showAuthNotification(`¡Medición de ${weightVal.toFixed(1)} kg guardada exitosamente!`, 'success');
        closeWeightModal();

        // Actualizar dashboard inmediatamente con la nueva medición
        const freshSummary = await dashboardService.getSummary(token);
        renderMetrics(freshSummary);
      } catch (err: unknown) {
        const errorMsg =
          err instanceof Error
            ? err.message
            : 'Error al registrar la medición de peso';

        if (errorBanner) {
          errorBanner.textContent = errorMsg;
          errorBanner.style.display = 'block';
        }
        showAuthNotification(errorMsg, 'error');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnText) submitBtnText.textContent = 'Guardar medición';
      }
    });

    // Función auxiliar para escapar texto en el renderizado
    const escapeHtml = (str: string) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    // Función para consultar y renderizar el listado de comidas del día
    const loadAndRenderTodayMeals = async () => {
      const emptyState = document.getElementById('meals-empty-state');
      const itemsList = document.getElementById('meals-items-list');
      const subtitle = document.getElementById('meals-count-subtitle');

      try {
        const todayStr = new Date().toISOString().slice(0, 10);
        const meals = await nutritionService.getMeals({ limit: 20 }, token);

        const now = new Date();
        const todaysMeals = meals.filter((m) => {
          if (m.healthDay?.localDate) return m.healthDay.localDate === todayStr;
          const d = new Date(m.occurredAt);
          return (
            d.getFullYear() === now.getFullYear() &&
            d.getMonth() === now.getMonth() &&
            d.getDate() === now.getDate()
          );
        });

        if (subtitle) {
          subtitle.textContent = `${todaysMeals.length} ${todaysMeals.length === 1 ? 'registro' : 'registros'} hoy`;
        }

        if (todaysMeals.length === 0) {
          if (emptyState) emptyState.style.display = 'flex';
          if (itemsList) {
            itemsList.style.display = 'none';
            itemsList.innerHTML = '';
          }
          return;
        }

        if (emptyState) emptyState.style.display = 'none';
        if (itemsList) {
          itemsList.style.display = 'flex';
          itemsList.innerHTML = todaysMeals
            .map((meal) => {
              const typeLabels: Record<string, { label: string; icon: string }> = {
                breakfast: { label: 'Desayuno', icon: '🌅' },
                lunch: { label: 'Comida', icon: '☀️' },
                dinner: { label: 'Cena', icon: '🌙' },
                snack: { label: 'Colación', icon: '🍎' },
                other: { label: 'Otro', icon: '🍽️' },
              };
              const meta = typeLabels[meal.mealType] || { label: meal.mealType, icon: '🍽️' };
              const timeStr = new Date(meal.occurredAt).toLocaleTimeString('es-MX', {
                hour: '2-digit',
                minute: '2-digit',
              });

              return `
                <div class="meal-item-card">
                  <div class="meal-item-top">
                    <div class="meal-item-header">
                      <span class="meal-item-icon">${meta.icon}</span>
                      <span class="meal-item-type">${meta.label}</span>
                    </div>
                    <div class="meal-item-actions">
                      <span class="meal-item-time">${timeStr}</span>
                      <button
                        type="button"
                        class="btn-delete-meal"
                        data-meal-id="${meal.id}"
                        title="Eliminar comida"
                        aria-label="Eliminar comida del registro"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                  <p class="meal-item-desc">${escapeHtml(meal.description)}</p>
                  <div class="meal-item-tags">
                    <span class="meal-tag-pill meal-tag-pill--hunger">Hambre previa: ${meal.hungerBefore}/10</span>
                    <span class="meal-tag-pill meal-tag-pill--satiety">Saciedad final: ${meal.satietyAfter}/10</span>
                    ${meal.wantedMoreEvenIfFull ? '<span class="meal-tag-pill meal-tag-pill--repeat">Deseo de repetir</span>' : ''}
                    ${meal.pausedBeforeMore ? '<span class="meal-tag-pill meal-tag-pill--pause">Pausa consciente ✓</span>' : ''}
                  </div>
                  ${meal.extraEatingContext ? `<div class="meal-item-context">💭 "${escapeHtml(meal.extraEatingContext)}"</div>` : ''}
                </div>
              `;
            })
            .join('');

          // Asignar listeners a botones de eliminar
          itemsList.querySelectorAll('.btn-delete-meal').forEach((btn) => {
            btn.addEventListener('click', async (e) => {
              const target = e.currentTarget as HTMLElement;
              const mealId = target.dataset.mealId;
              if (!mealId) return;

              if (!confirm('¿Deseas eliminar este registro de comida?')) return;

              target.setAttribute('disabled', 'true');
              try {
                await nutritionService.deleteMeal(mealId, token);
                showAuthNotification('Comida eliminada exitosamente', 'info');
                const freshSummary = await dashboardService.getSummary(token);
                renderMetrics(freshSummary);
                await loadAndRenderTodayMeals();
              } catch (err: unknown) {
                const errorMsg =
                  err instanceof Error
                    ? err.message
                    : 'Error al eliminar la comida';
                showAuthNotification(errorMsg, 'error');
                target.removeAttribute('disabled');
              }
            });
          });
        }
      } catch (err) {
        console.warn('Error cargando comidas de hoy:', err);
      }
    };

    // Cargar comidas de hoy en el inicio
    loadAndRenderTodayMeals();

    // 4. Modal de registro de comida y saciedad
    const mealModal = document.getElementById('meal-modal') as HTMLDialogElement | null;
    const mealForm = document.getElementById('meal-form') as HTMLFormElement | null;
    const mealDateInput = document.getElementById('input-meal-date') as HTMLInputElement | null;
    const mealDescInput = document.getElementById('input-meal-desc') as HTMLTextAreaElement | null;
    const hungerRange = document.getElementById('input-hunger-level') as HTMLInputElement | null;
    const hungerNum = document.getElementById('hunger-level-number');
    const hungerBadge = document.getElementById('hunger-level-badge');
    const satietyRange = document.getElementById('input-satiety-level') as HTMLInputElement | null;
    const satietyNum = document.getElementById('satiety-level-number');
    const satietyBadge = document.getElementById('satiety-level-badge');
    const checkWantedMore = document.getElementById('check-wanted-more') as HTMLInputElement | null;
    const wrapMoreQuestions = document.getElementById('wrap-more-questions');
    const checkPausedBefore = document.getElementById('check-paused-before') as HTMLInputElement | null;
    const extraContextInput = document.getElementById('input-extra-context') as HTMLInputElement | null;
    const mealErrorBanner = document.getElementById('meal-form-error');
    const submitMealBtn = document.getElementById('btn-submit-meal') as HTMLButtonElement | null;
    const submitMealText = document.getElementById('btn-submit-meal-text');

    const updateHungerUI = (val: number) => {
      if (hungerNum) hungerNum.textContent = String(val);
      if (hungerBadge) {
        if (val <= 2) hungerBadge.textContent = 'Sin hambre';
        else if (val <= 4) hungerBadge.textContent = 'Hambre leve';
        else if (val <= 6) hungerBadge.textContent = 'Hambre moderada';
        else if (val <= 8) hungerBadge.textContent = 'Hambre intensa';
        else hungerBadge.textContent = 'Hambre voraz / urgente';
      }
    };

    const updateSatietyUI = (val: number) => {
      if (satietyNum) satietyNum.textContent = String(val);
      if (satietyBadge) {
        if (val <= 2) {
          satietyBadge.className = 'level-badge';
          satietyBadge.textContent = 'Sigo con hambre';
        } else if (val <= 4) {
          satietyBadge.className = 'level-badge';
          satietyBadge.textContent = 'Apenas satisfecho';
        } else if (val <= 6) {
          satietyBadge.className = 'level-badge level-badge--success';
          satietyBadge.textContent = 'Satisfecho ligero';
        } else if (val <= 8) {
          satietyBadge.className = 'level-badge level-badge--success';
          satietyBadge.textContent = 'Satisfecho pleno';
        } else {
          satietyBadge.className = 'level-badge';
          satietyBadge.textContent = 'Excesivamente lleno';
        }
      }
    };

    hungerRange?.addEventListener('input', (e) => {
      updateHungerUI(parseInt((e.target as HTMLInputElement).value, 10));
    });

    satietyRange?.addEventListener('input', (e) => {
      updateSatietyUI(parseInt((e.target as HTMLInputElement).value, 10));
    });

    checkWantedMore?.addEventListener('change', () => {
      if (wrapMoreQuestions) {
        wrapMoreQuestions.style.display = checkWantedMore.checked ? 'flex' : 'none';
      }
    });

    const openMealModal = () => {
      if (!mealModal) return;
      if (mealErrorBanner) {
        mealErrorBanner.style.display = 'none';
        mealErrorBanner.textContent = '';
      }
      if (mealDescInput) mealDescInput.value = '';
      if (hungerRange) hungerRange.value = '5';
      updateHungerUI(5);
      if (satietyRange) satietyRange.value = '7';
      updateSatietyUI(7);
      if (checkWantedMore) checkWantedMore.checked = false;
      if (checkPausedBefore) checkPausedBefore.checked = false;
      if (extraContextInput) extraContextInput.value = '';
      if (wrapMoreQuestions) wrapMoreQuestions.style.display = 'none';

      // Reset meal type to lunch by default
      const defaultTypeRadio = mealModal.querySelector('input[name="mealType"][value="lunch"]') as HTMLInputElement | null;
      if (defaultTypeRadio) defaultTypeRadio.checked = true;

      if (mealDateInput) {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        mealDateInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
      }

      mealModal.showModal();
      setTimeout(() => mealDescInput?.focus(), 50);
    };

    const closeMealModal = () => {
      if (mealModal && mealModal.open) {
        mealModal.close();
      }
    };

    document.getElementById('action-comida')?.addEventListener('click', openMealModal);
    document.getElementById('btn-add-meal-card')?.addEventListener('click', openMealModal);
    document.getElementById('btn-card-register-meal')?.addEventListener('click', openMealModal);
    document.getElementById('btn-header-add-meal')?.addEventListener('click', openMealModal);
    document.getElementById('btn-close-meal-modal')?.addEventListener('click', closeMealModal);
    document.getElementById('btn-cancel-meal')?.addEventListener('click', closeMealModal);

    mealModal?.addEventListener('click', (e) => {
      if (e.target === mealModal) closeMealModal();
    });

    mealForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!mealDescInput) return;

      const description = mealDescInput.value.trim();
      if (!description || description.length < 2) {
        if (mealErrorBanner) {
          mealErrorBanner.textContent = 'Por favor describe los alimentos o porciones consumidas.';
          mealErrorBanner.style.display = 'block';
        }
        mealDescInput.focus();
        return;
      }

      const selectedTypeInput = mealModal?.querySelector('input[name="mealType"]:checked') as HTMLInputElement | null;
      const mealType = (selectedTypeInput?.value || 'lunch') as MealType;
      const hungerBefore = hungerRange ? parseInt(hungerRange.value, 10) : 5;
      const satietyAfter = satietyRange ? parseInt(satietyRange.value, 10) : 7;
      const wantedMore = checkWantedMore ? checkWantedMore.checked : false;
      const pausedBefore = wantedMore ? (checkPausedBefore ? checkPausedBefore.checked : false) : null;
      const extraContext = (wantedMore && extraContextInput && extraContextInput.value.trim()) ? extraContextInput.value.trim() : null;

      let occurredAt: string | undefined = undefined;
      if (mealDateInput && mealDateInput.value) {
        try {
          const parsed = new Date(mealDateInput.value);
          if (!isNaN(parsed.getTime())) occurredAt = parsed.toISOString();
        } catch {
          // Dejar undefined para que el backend asigne 'now'
        }
      }

      if (submitMealBtn) submitMealBtn.disabled = true;
      if (submitMealText) submitMealText.textContent = 'Guardando...';
      if (mealErrorBanner) mealErrorBanner.style.display = 'none';

      try {
        await nutritionService.createMeal(
          {
            mealType,
            description,
            hungerBefore,
            satietyAfter,
            occurredAt,
            wantedMoreEvenIfFull: wantedMore,
            pausedBeforeMore: pausedBefore,
            extraEatingContext: extraContext,
          },
          token
        );

        showAuthNotification('¡Comida registrada exitosamente!', 'success');
        closeMealModal();

        // Actualizar dashboard y listado de comidas inmediatamente
        const freshSummary = await dashboardService.getSummary(token);
        renderMetrics(freshSummary);
        await loadAndRenderTodayMeals();
      } catch (err: unknown) {
        const errorMsg =
          err instanceof Error
            ? err.message
            : 'Error al registrar la comida';
        if (mealErrorBanner) {
          mealErrorBanner.textContent = errorMsg;
          mealErrorBanner.style.display = 'block';
        }
        showAuthNotification(errorMsg, 'error');
      } finally {
        if (submitMealBtn) submitMealBtn.disabled = false;
        if (submitMealText) submitMealText.textContent = 'Guardar comida';
      }
    });

    // 5. Modal de registro de actividad física (Pasos y Ejercicio)
    const activityModal = document.getElementById('activity-modal') as HTMLDialogElement | null;
    const tabBtnSteps = document.getElementById('tab-btn-steps');
    const tabBtnExercise = document.getElementById('tab-btn-exercise');
    const paneSteps = document.getElementById('pane-steps');
    const paneExercise = document.getElementById('pane-exercise');

    const stepsForm = document.getElementById('steps-form') as HTMLFormElement | null;
    const stepsInput = document.getElementById('input-steps-count') as HTMLInputElement | null;
    const stepsDateInput = document.getElementById('input-steps-date') as HTMLInputElement | null;
    const stepsBar = document.getElementById('preview-steps-bar');
    const stepsPct = document.getElementById('preview-steps-pct');
    const stepsErrorBanner = document.getElementById('steps-form-error');
    const stepsSubmitBtn = document.getElementById('btn-submit-steps') as HTMLButtonElement | null;
    const stepsSubmitBtnText = document.getElementById('btn-submit-steps-text');

    const exerciseForm = document.getElementById('exercise-form') as HTMLFormElement | null;
    const exerciseDurationInput = document.getElementById('input-exercise-duration') as HTMLInputElement | null;
    const exerciseOccurredInput = document.getElementById('input-exercise-occurred') as HTMLInputElement | null;
    const exerciseCaloriesInput = document.getElementById('input-exercise-calories') as HTMLInputElement | null;
    const exerciseNotesInput = document.getElementById('input-exercise-notes') as HTMLTextAreaElement | null;
    const exerciseErrorBanner = document.getElementById('exercise-form-error');
    const exerciseSubmitBtn = document.getElementById('btn-submit-exercise') as HTMLButtonElement | null;
    const exerciseSubmitBtnText = document.getElementById('btn-submit-exercise-text');

    function switchActivityTab(tab: 'steps' | 'exercise') {
      if (tab === 'steps') {
        tabBtnSteps?.classList.add('is-active');
        tabBtnSteps?.setAttribute('aria-selected', 'true');
        tabBtnExercise?.classList.remove('is-active');
        tabBtnExercise?.setAttribute('aria-selected', 'false');
        if (paneSteps) paneSteps.style.display = 'flex';
        if (paneExercise) paneExercise.style.display = 'none';
      } else {
        tabBtnExercise?.classList.add('is-active');
        tabBtnExercise?.setAttribute('aria-selected', 'true');
        tabBtnSteps?.classList.remove('is-active');
        tabBtnSteps?.setAttribute('aria-selected', 'false');
        if (paneExercise) paneExercise.style.display = 'flex';
        if (paneSteps) paneSteps.style.display = 'none';
      }
    }

    function updateStepsPreview() {
      const count = parseInt(stepsInput?.value || '0', 10) || 0;
      const goal = 10000;
      const pct = Math.min(150, Math.round((count / goal) * 100));
      if (stepsBar) stepsBar.style.width = `${Math.min(100, pct)}%`;
      if (stepsPct) stepsPct.textContent = `${pct}% de tu meta diaria (${count.toLocaleString()} / ${goal.toLocaleString()})`;
    }

    stepsInput?.addEventListener('input', updateStepsPreview);

    function openActivityModal(defaultTab: 'steps' | 'exercise' = 'steps') {
      switchActivityTab(defaultTab);
      if (stepsErrorBanner) stepsErrorBanner.style.display = 'none';
      if (exerciseErrorBanner) exerciseErrorBanner.style.display = 'none';

      const now = new Date();
      const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
      if (stepsDateInput && !stepsDateInput.value) {
        stepsDateInput.value = todayStr;
      }

      const tzOffset = now.getTimezoneOffset() * 60000;
      const localIsoTime = new Date(now.getTime() - tzOffset).toISOString().slice(0, 16);
      if (exerciseOccurredInput && !exerciseOccurredInput.value) {
        exerciseOccurredInput.value = localIsoTime;
      }

      updateStepsPreview();
      activityModal?.showModal();
    }

    function closeActivityModal() {
      activityModal?.close();
    }

    tabBtnSteps?.addEventListener('click', () => switchActivityTab('steps'));
    tabBtnExercise?.addEventListener('click', () => switchActivityTab('exercise'));

    document.getElementById('action-actividad')?.addEventListener('click', () => openActivityModal('steps'));
    document.getElementById('btn-add-activity-card')?.addEventListener('click', () => openActivityModal('steps'));
    document.getElementById('btn-card-register-activity')?.addEventListener('click', () => openActivityModal('steps'));
    document.getElementById('btn-close-activity-modal')?.addEventListener('click', closeActivityModal);
    document.getElementById('btn-cancel-steps')?.addEventListener('click', closeActivityModal);
    document.getElementById('btn-cancel-exercise')?.addEventListener('click', closeActivityModal);

    activityModal?.addEventListener('click', (e) => {
      if (e.target === activityModal) closeActivityModal();
    });

    // Atajos de duración
    document.querySelectorAll('.quick-chip-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const mins = (e.currentTarget as HTMLElement).getAttribute('data-minutes');
        if (mins && exerciseDurationInput) {
          exerciseDurationInput.value = mins;
        }
      });
    });

    // Guardar Pasos
    stepsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = authService.getStoredToken();
      if (!token) {
        showAuthNotification('Debes iniciar sesión para registrar pasos', 'error');
        return;
      }

      const stepsVal = parseInt(stepsInput?.value || '', 10);
      if (isNaN(stepsVal) || stepsVal < 0) {
        if (stepsErrorBanner) {
          stepsErrorBanner.textContent = 'Por favor ingresa un total de pasos válido (mayor o igual a 0).';
          stepsErrorBanner.style.display = 'block';
        }
        return;
      }

      try {
        if (stepsSubmitBtn) stepsSubmitBtn.disabled = true;
        if (stepsSubmitBtnText) stepsSubmitBtnText.textContent = 'Guardando...';

        await activityService.recordSteps(
          {
            steps: stepsVal,
            localDate: stepsDateInput?.value || undefined,
          },
          token
        );

        showAuthNotification('¡Pasos registrados exitosamente!', 'success');
        closeActivityModal();

        // Actualizar dashboard inmediatamente
        const freshSummary = await dashboardService.getSummary(token);
        renderMetrics(freshSummary);
      } catch (err: unknown) {
        const errorMsg = err instanceof Error ? err.message : 'Error al registrar los pasos';
        if (stepsErrorBanner) {
          stepsErrorBanner.textContent = errorMsg;
          stepsErrorBanner.style.display = 'block';
        }
        showAuthNotification(errorMsg, 'error');
      } finally {
        if (stepsSubmitBtn) stepsSubmitBtn.disabled = false;
        if (stepsSubmitBtnText) stepsSubmitBtnText.textContent = 'Guardar pasos';
      }
    });

    // Guardar Ejercicio
    exerciseForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = authService.getStoredToken();
      if (!token) {
        showAuthNotification('Debes iniciar sesión para registrar ejercicio', 'error');
        return;
      }

      const durationVal = parseInt(exerciseDurationInput?.value || '', 10);
      if (isNaN(durationVal) || durationVal <= 0) {
        if (exerciseErrorBanner) {
          exerciseErrorBanner.textContent = 'Por favor ingresa una duración en minutos válida (mayor a 0).';
          exerciseErrorBanner.style.display = 'block';
        }
        return;
      }

      const formData = new FormData(exerciseForm);
      const exerciseType = (formData.get('exerciseType') as ExerciseType) || 'walking';
      const intensity = (formData.get('intensity') as ExerciseIntensity) || undefined;
      const occurredVal = exerciseOccurredInput?.value ? new Date(exerciseOccurredInput.value).toISOString() : undefined;
      const caloriesVal = exerciseCaloriesInput?.value ? parseInt(exerciseCaloriesInput.value, 10) : undefined;
      const notesVal = exerciseNotesInput?.value?.trim() || undefined;

      try {
        if (exerciseSubmitBtn) exerciseSubmitBtn.disabled = true;
        if (exerciseSubmitBtnText) exerciseSubmitBtnText.textContent = 'Guardando...';

        await activityService.recordExercise(
          {
            exerciseType,
            durationMinutes: durationVal,
            intensity,
            occurredAt: occurredVal,
            caloriesBurned: caloriesVal,
            notes: notesVal,
          },
          token
        );

        showAuthNotification('¡Sesión de ejercicio guardada exitosamente!', 'success');
        closeActivityModal();

        // Resetear campos opcionales
        if (exerciseDurationInput) exerciseDurationInput.value = '';
        if (exerciseCaloriesInput) exerciseCaloriesInput.value = '';
        if (exerciseNotesInput) exerciseNotesInput.value = '';

        // Actualizar dashboard inmediatamente
        const freshSummary = await dashboardService.getSummary(token);
        renderMetrics(freshSummary);
      } catch (err: unknown) {
        const errorMsg = err instanceof Error ? err.message : 'Error al registrar el ejercicio';
        if (exerciseErrorBanner) {
          exerciseErrorBanner.textContent = errorMsg;
          exerciseErrorBanner.style.display = 'block';
        }
        showAuthNotification(errorMsg, 'error');
      } finally {
        if (exerciseSubmitBtn) exerciseSubmitBtn.disabled = false;
        if (exerciseSubmitBtnText) exerciseSubmitBtnText.textContent = 'Guardar sesión';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeDashboard);
  } else {
    initializeDashboard();
  }
</script>
