---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/ui/Header.astro';
import GoogleButton from '../../components/ui/GoogleButton.astro';
import { getAppUrl } from '../../utils/paths';

const homeUrl = getAppUrl();
---

<MainLayout title="Tu espacio personal" description="Panel de control personal para el seguimiento de peso, alimentación y actividad física.">
  <Header isDashboard={true} />

  <main class="dashboard-container">
    <!-- Estado 1: No autenticado (Guardia visual para visitantes sin sesión) -->
    <section id="auth-required-view" class="auth-gate-card" style="display: none;">
      <div class="auth-gate-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h1 class="display-sm">Acceso a tu espacio personal</h1>
      <p class="body-md text-body auth-gate-desc">
        Para ver tu evolución, registros de peso, hábitos de alimentación y pasos diarios, inicia sesión con tu cuenta de Google.
      </p>
      <div class="auth-gate-actions">
        <GoogleButton variant="cta" text="Iniciar sesión con Google" />
        <a href={homeUrl} class="btn-ghost-sm">Volver al inicio</a>
      </div>
    </section>

    <!-- Estado 2: Vista de Usuario Autenticado -->
    <section id="dashboard-view" class="dashboard-content" style="display: none;">
      <!-- Hero de bienvenida del usuario -->
      <header class="user-hero-card">
        <div class="user-hero-main">
          <div class="user-avatar-lg" id="view-user-avatar-wrap">
            <img class="user-avatar-lg-img" id="view-user-photo" src="" alt="" style="display: none;" />
            <span id="view-user-avatar">U</span>
          </div>
          <div class="user-hero-text">
            <div class="user-hero-eyebrow">
              <span class="status-indicator"></span> Sesión activa
            </div>
            <h1 class="display-md" id="view-user-name">Usuario</h1>
            <p class="body-sm text-body" id="view-user-email">usuario@ejemplo.com</p>
          </div>
        </div>

        <div class="user-hero-motto">
          <div class="motto-badge">
            <span class="motto-icon" aria-hidden="true">🌱</span>
            <span class="motto-text">Hábitos conscientes y progreso constante, un día a la vez.</span>
          </div>
        </div>
      </header>

      <!-- Barra de acciones rápidas -->
      <div class="quick-actions-bar">
        <span class="body-sm text-body-strong">Acciones rápidas:</span>
        <div class="quick-buttons">
          <button type="button" class="btn-action" id="action-peso">
            <span class="action-icon">⚖️</span> Registrar peso
          </button>
          <button type="button" class="btn-action" id="action-comida">
            <span class="action-icon">🍽️</span> Registrar comida y saciedad
          </button>
          <button type="button" class="btn-action" id="action-actividad">
            <span class="action-icon">🏃</span> Registrar pasos / ejercicio
          </button>
        </div>
      </div>

      <!-- Métricas Clave y Resumen de Estado (Datos reales del backend / Sin datos dummy) -->
      <section class="metrics-grid">
        <!-- Tarjeta: Peso Corporal -->
        <article class="metric-card" id="card-peso">
          <div class="metric-card-header">
            <div>
              <span class="caption text-mute">Seguimiento</span>
              <h2 class="metric-card-title">Peso corporal</h2>
            </div>
            <div class="metric-header-actions">
              <span class="metric-tag" id="metric-peso-tag">Sin registro</span>
              <button
                type="button"
                class="btn-metric-add"
                id="btn-add-weight-card"
                title="Registrar nuevo peso"
                aria-label="Registrar nueva medición de peso"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="metric-value-wrap">
            <span class="metric-number metric-empty" id="metric-peso-val">--</span>
            <span class="metric-unit" id="metric-peso-unit">kg</span>
          </div>
          <div class="metric-trend-wrap" id="metric-peso-trend-wrap">
            <span class="metric-empty-notice" id="metric-peso-status-text">Sin mediciones registradas en el historial.</span>
          </div>
          <div id="metric-peso-cta-wrap" class="metric-cta-wrap">
            <button type="button" class="btn-card-cta" id="btn-card-register-peso">
              + Registrar primer peso
            </button>
          </div>
          <div class="metric-footer">
            <span class="caption text-mute" id="metric-peso-footer">Promedio mensual: Sin datos aún</span>
          </div>
        </article>

        <!-- Tarjeta: Actividad Física (Pasos y Ejercicio) -->
        <article class="metric-card" id="card-actividad">
          <div class="metric-card-header">
            <div>
              <span class="caption text-mute">Actividad física</span>
              <h2 class="metric-card-title">Pasos y Ejercicio</h2>
            </div>
            <span class="metric-tag">Hoy</span>
          </div>
          <div class="metric-value-wrap">
            <span class="metric-number" id="metric-pasos-val">0</span>
            <span class="metric-unit">pasos</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" id="metric-pasos-progress" style="width: 0%;"></div>
          </div>
          <div class="metric-split">
            <div class="split-col">
              <span class="caption text-mute">Meta diaria</span>
              <span class="body-sm text-body-strong" id="metric-pasos-goal">10,000 pasos</span>
            </div>
            <div class="split-col">
              <span class="caption text-mute">Ejercicio</span>
              <span class="body-sm text-body-strong" id="metric-ejercicio-min">0 min</span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="caption text-mute" id="metric-actividad-footer">Sin actividad registrada el día de hoy</span>
          </div>
        </article>

        <!-- Tarjeta: Alimentación y Saciedad -->
        <article class="metric-card" id="card-alimentacion">
          <div class="metric-card-header">
            <div>
              <span class="caption text-mute">Patrones</span>
              <h2 class="metric-card-title">Alimentación y Saciedad</h2>
            </div>
            <span class="metric-tag">Hoy</span>
          </div>
          <div class="metric-value-wrap">
            <span class="metric-number" id="metric-comidas-val">0</span>
            <span class="metric-unit" id="metric-comidas-unit">comidas registradas</span>
          </div>
          <div class="satiety-indicator">
            <span class="satiety-label caption text-mute">Nivel de saciedad promedio:</span>
            <span class="satiety-badge satiety-badge--empty" id="metric-saciedad-badge">Sin registros de saciedad hoy</span>
          </div>
          <div class="metric-split">
            <div class="split-col">
              <span class="caption text-mute">Pausas conscientes</span>
              <span class="body-sm text-body-strong" id="metric-pausas-val">0 registradas</span>
            </div>
            <div class="split-col">
              <span class="caption text-mute">Repetición por gusto</span>
              <span class="body-sm text-body-strong" id="metric-repeticion-val">0 veces</span>
            </div>
          </div>
          <div class="metric-footer">
            <span class="caption text-mute" id="metric-alimentacion-footer">Registra tu primera comida para comenzar el seguimiento</span>
          </div>
        </article>
      </section>
    </section>

    <!-- Dialog modal interactivo para Registrar Peso Corporal -->
    <dialog id="weight-modal" class="app-modal" aria-labelledby="weight-modal-title">
      <div class="app-modal-content">
        <div class="app-modal-header">
          <div class="app-modal-title-wrap">
            <span class="app-modal-icon" aria-hidden="true">⚖️</span>
            <div>
              <h2 id="weight-modal-title" class="app-modal-title">Registrar peso corporal</h2>
              <span class="caption text-mute">Seguimiento diario de evolución</span>
            </div>
          </div>
          <button type="button" class="btn-dialog-close" id="btn-close-weight-modal" aria-label="Cerrar ventana de registro">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <form id="weight-form" class="app-modal-form" novalidate>
          <div id="weight-form-error" class="form-error-banner" style="display: none;" role="alert"></div>

          <div class="form-field">
            <label for="input-weight-kg" class="form-label">
              Peso en kilogramos <span class="required-star">*</span>
            </label>
            <div class="input-with-suffix">
              <input
                type="number"
                id="input-weight-kg"
                name="weightKg"
                step="0.01"
                min="20.0"
                max="350.0"
                placeholder="Ej. 78.50"
                required
                class="form-input text-input-lg"
              />
              <span class="input-suffix">kg</span>
            </div>
            <span class="caption text-mute form-help">Rango permitido: 20.0 a 350.0 kg (hasta 2 decimales).</span>
          </div>

          <div class="form-field">
            <label for="input-weight-date" class="form-label">
              Fecha y hora de la medición
            </label>
            <input
              type="datetime-local"
              id="input-weight-date"
              name="occurredAt"
              class="form-input"
            />
            <span class="caption text-mute form-help">Opcional. Si se deja en blanco, se guardará el momento actual.</span>
          </div>

          <div class="app-modal-actions">
            <button type="button" class="btn-cancel" id="btn-cancel-weight">
              Cancelar
            </button>
            <button type="submit" class="btn-submit" id="btn-submit-weight">
              <span id="btn-submit-weight-text">Guardar medición</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>
  </main>
</MainLayout>

<style>
  .dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) var(--space-4xl);
  }

  /* Guardia para visitantes sin login */
  .auth-gate-card {
    max-width: 520px;
    margin: var(--space-4xl) auto;
    padding: var(--space-3xl);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .auth-gate-badge {
    width: 48px;
    height: 48px;
    border-radius: var(--rounded-full);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-body);
  }

  .auth-gate-desc {
    max-width: 420px;
  }

  .auth-gate-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    margin-top: var(--space-sm);
  }

  .btn-ghost-sm {
    font-size: 13px;
    color: var(--color-mute);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--rounded-sm);
    transition: color 0.15s ease;
  }

  .btn-ghost-sm:hover {
    color: var(--color-ink);
  }

  /* Vista de Dashboard autenticado */
  .dashboard-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* User Hero Card */
  .user-hero-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding: var(--space-2xl);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
  }

  @media (min-width: 768px) {
    .user-hero-card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .user-hero-main {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .user-avatar-lg {
    width: 64px;
    height: 64px;
    border-radius: var(--rounded-full);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  .user-avatar-lg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--rounded-full);
  }

  .user-hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .user-hero-eyebrow {
    font-size: 12px;
    font-weight: 500;
    color: #4ade80;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: var(--rounded-full);
    background-color: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .user-hero-motto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .user-hero-motto {
      align-items: flex-end;
      text-align: right;
    }
  }

  .motto-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-full);
    font-size: 13px;
    color: var(--color-body);
    font-style: italic;
    max-width: 380px;
  }

  .motto-icon {
    font-style: normal;
    font-size: 14px;
  }

  .motto-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Quick Actions Bar */
  .quick-actions-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
  }

  .quick-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .btn-action:hover {
    background-color: #443e3a;
    border-color: var(--color-mute);
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 900px) {
    .metrics-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-card {
    padding: var(--space-xl);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .metric-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .metric-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .metric-card-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    margin-top: 2px;
  }

  .metric-tag {
    font-size: 11px;
    padding: 2px 6px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-xs);
    color: var(--color-mute);
  }

  .btn-metric-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--rounded-xs);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-mute);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-metric-add:hover {
    color: var(--color-ink);
    border-color: var(--color-mute);
    background-color: #443e3a;
  }

  .metric-value-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .metric-number {
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--color-primary);
  }

  .metric-number.metric-empty {
    color: var(--color-mute);
    opacity: 0.85;
  }

  .metric-unit {
    font-size: 14px;
    color: var(--color-body);
  }

  .metric-trend-wrap {
    min-height: 20px;
    display: flex;
    align-items: center;
  }

  .metric-empty-notice {
    font-size: 12px;
    color: var(--color-mute);
  }

  .metric-cta-wrap {
    margin-top: var(--space-xs);
  }

  .btn-card-cta {
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border: 1px dashed var(--color-hairline);
    border-radius: var(--rounded-sm);
    cursor: pointer;
    text-align: center;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-card-cta:hover {
    color: var(--color-ink);
    border-color: var(--color-mute);
    background-color: #443e3a;
  }

  .metric-trend {
    font-size: 13px;
    font-weight: 500;
  }

  .metric-trend--down {
    color: #4ade80;
  }

  .metric-trend--up {
    color: #f87171;
  }

  .progress-bar-bg {
    width: 100%;
    height: 6px;
    background-color: var(--color-canvas);
    border-radius: var(--rounded-full);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--color-primary);
    border-radius: var(--rounded-full);
    transition: width 0.3s ease;
  }

  .metric-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-hairline);
  }

  .split-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .satiety-indicator {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .satiety-badge {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background-color: rgba(74, 222, 128, 0.1);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: var(--rounded-sm);
    font-size: 13px;
    font-weight: 500;
  }

  .satiety-badge--empty {
    background-color: var(--color-canvas);
    color: var(--color-mute);
    border-color: var(--color-hairline);
  }

  .metric-footer {
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-hairline);
  }

  /* Estilos para Modal de Registro (Design System Warp-inspired) */
  .app-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    padding: 0;
    width: 92%;
    max-width: 440px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6);
    z-index: 1000;
  }

  .app-modal::backdrop {
    background-color: rgba(18, 16, 14, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .app-modal-content {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .app-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .app-modal-title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .app-modal-icon {
    font-size: 24px;
  }

  .app-modal-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .btn-dialog-close {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mute);
    border-radius: var(--rounded-sm);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .btn-dialog-close:hover {
    color: var(--color-ink);
    background-color: var(--color-canvas-soft);
  }

  .app-modal-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body-strong);
  }

  .required-star {
    color: #f87171;
  }

  .form-input {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    color: var(--color-ink);
    font-size: 14px;
    font-family: var(--font-sans);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-mute);
    box-shadow: 0 0 0 2px rgba(247, 245, 240, 0.1);
  }

  .input-with-suffix {
    position: relative;
    display: flex;
    align-items: center;
  }

  .text-input-lg {
    font-size: 20px;
    font-weight: 500;
    padding-right: 48px;
  }

  .input-suffix {
    position: absolute;
    right: var(--space-md);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-mute);
    pointer-events: none;
  }

  .form-help {
    font-size: 11px;
    color: var(--color-mute);
  }

  .form-error-banner {
    padding: var(--space-xs) var(--space-md);
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--rounded-sm);
    color: #fca5a5;
    font-size: 13px;
    line-height: 1.4;
  }

  .app-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .btn-cancel {
    padding: var(--space-sm) var(--space-md);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body);
    background-color: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-cancel:hover {
    color: var(--color-ink);
    border-color: var(--color-mute);
    background-color: var(--color-canvas-soft);
  }

  .btn-submit {
    padding: var(--space-sm) var(--space-lg);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--rounded-sm);
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }

  .btn-submit:hover {
    opacity: 0.92;
  }

  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  import { authService } from '../../services/auth.service';
  import { dashboardService } from '../../services/dashboard.service';
  import { weightService } from '../../services/weight.service';
  import { showAuthNotification } from '../../utils/auth-client';
  import type { AuthenticatedUser } from '../../types/auth';
  import type { DashboardSummary } from '../../types/dashboard';

  async function initializeDashboard() {
    const gateView = document.getElementById('auth-required-view');
    const dashboardView = document.getElementById('dashboard-view');

    const token = authService.getStoredToken();
    const storedUser = authService.getStoredUser();

    if (!token) {
      if (gateView) gateView.style.display = 'flex';
      if (dashboardView) dashboardView.style.display = 'none';
      return;
    }

    // Usuario autenticado
    if (gateView) gateView.style.display = 'none';
    if (dashboardView) dashboardView.style.display = 'flex';

    // 1. Renderizar perfil de usuario en el hero (Avatar con foto de Google o inicial)
    const renderUserProfile = (user: AuthenticatedUser) => {
      const nameEl = document.getElementById('view-user-name');
      const emailEl = document.getElementById('view-user-email');
      const photoEl = document.getElementById('view-user-photo') as HTMLImageElement | null;
      const initialEl = document.getElementById('view-user-avatar');

      if (nameEl && user.name) nameEl.textContent = user.name;
      if (emailEl && user.email) emailEl.textContent = user.email;

      const initial = user.name ? user.name.trim().charAt(0).toUpperCase() : 'U';
      if (initialEl) initialEl.textContent = initial;

      if (user.picture && photoEl) {
        photoEl.src = user.picture;
        photoEl.alt = user.name || 'Avatar';
        photoEl.style.display = 'block';
        if (initialEl) initialEl.style.display = 'none';

        photoEl.onerror = () => {
          photoEl.style.display = 'none';
          if (initialEl) initialEl.style.display = 'block';
        };
      } else {
        if (photoEl) photoEl.style.display = 'none';
        if (initialEl) initialEl.style.display = 'block';
      }
    };

    if (storedUser) {
      renderUserProfile(storedUser);
    }

    // 2. Renderizar métricas reales en las cards (Sin datos dummy)
    const renderMetrics = (summary: DashboardSummary) => {
      // Card 1: Peso corporal
      const pesoVal = document.getElementById('metric-peso-val');
      const pesoTag = document.getElementById('metric-peso-tag');
      const pesoTrendWrap = document.getElementById('metric-peso-trend-wrap');
      const pesoFooter = document.getElementById('metric-peso-footer');
      const pesoCtaWrap = document.getElementById('metric-peso-cta-wrap');

      if (summary.weight.hasMeasurements && summary.weight.latestKg != null) {
        if (pesoVal) {
          pesoVal.textContent = summary.weight.latestKg.toFixed(1);
          pesoVal.classList.remove('metric-empty');
        }
        if (pesoTag) pesoTag.textContent = summary.weight.latestDate || 'Último';
        if (pesoCtaWrap) pesoCtaWrap.style.display = 'none';

        if (pesoTrendWrap) {
          if (summary.weight.differenceKg != null) {
            const isDown = summary.weight.differenceKg <= 0;
            const diffFormatted = Math.abs(summary.weight.differenceKg).toFixed(1);
            pesoTrendWrap.innerHTML = `
              <span class="metric-trend ${isDown ? 'metric-trend--down' : 'metric-trend--up'}">
                ${isDown ? '↓' : '↑'} ${diffFormatted} kg respecto a la anterior
              </span>
            `;
          } else {
            pesoTrendWrap.innerHTML = '<span class="metric-empty-notice">Medición registrada hoy</span>';
          }
        }

        if (pesoFooter) {
          pesoFooter.textContent = summary.weight.monthlyAverageKg != null
            ? `Promedio del mes: ${summary.weight.monthlyAverageKg.toFixed(1)} kg`
            : 'Medición registrada';
        }
      } else {
        // Estado real: Sin mediciones registradas en la base de datos
        if (pesoVal) {
          pesoVal.textContent = '--';
          pesoVal.classList.add('metric-empty');
        }
        if (pesoTag) pesoTag.textContent = 'Sin registro';
        if (pesoCtaWrap) pesoCtaWrap.style.display = 'block';
        if (pesoTrendWrap) {
          pesoTrendWrap.innerHTML = '<span class="metric-empty-notice">Sin mediciones registradas en el historial.</span>';
        }
        if (pesoFooter) {
          pesoFooter.textContent = 'Promedio mensual: Sin datos aún';
        }
      }

      // Card 2: Actividad Física (Pasos y Ejercicio)
      const pasosVal = document.getElementById('metric-pasos-val');
      const pasosProgress = document.getElementById('metric-pasos-progress');
      const pasosGoal = document.getElementById('metric-pasos-goal');
      const ejercicioMin = document.getElementById('metric-ejercicio-min');
      const actividadFooter = document.getElementById('metric-actividad-footer');

      if (summary.activity.hasActivityToday && summary.activity.steps > 0) {
        if (pasosVal) pasosVal.textContent = summary.activity.steps.toLocaleString();
        const pct = Math.min(100, Math.round((summary.activity.steps / summary.activity.stepsGoal) * 100));
        if (pasosProgress) pasosProgress.style.width = `${pct}%`;
        if (pasosGoal) pasosGoal.textContent = `${summary.activity.stepsGoal.toLocaleString()} pasos`;
        if (ejercicioMin) ejercicioMin.textContent = `${summary.activity.exerciseMinutes} min`;
        if (actividadFooter) {
          actividadFooter.textContent = summary.activity.weeklyAverageSteps != null
            ? `Promedio semanal: ${summary.activity.weeklyAverageSteps.toLocaleString()} pasos / día`
            : 'Actividad registrada hoy';
        }
      } else {
        // Estado real: Sin actividad registrada hoy
        if (pasosVal) pasosVal.textContent = '0';
        if (pasosProgress) pasosProgress.style.width = '0%';
        if (pasosGoal) pasosGoal.textContent = '10,000 pasos';
        if (ejercicioMin) ejercicioMin.textContent = '0 min';
        if (actividadFooter) actividadFooter.textContent = 'Sin actividad registrada el día de hoy';
      }

      // Card 3: Alimentación y Saciedad
      const comidasVal = document.getElementById('metric-comidas-val');
      const comidasUnit = document.getElementById('metric-comidas-unit');
      const saciedadBadge = document.getElementById('metric-saciedad-badge');
      const pausasVal = document.getElementById('metric-pausas-val');
      const repeticionVal = document.getElementById('metric-repeticion-val');
      const alimentacionFooter = document.getElementById('metric-alimentacion-footer');

      if (summary.nutrition.hasMealsToday && summary.nutrition.mealsCount > 0) {
        if (comidasVal) comidasVal.textContent = String(summary.nutrition.mealsCount);
        if (comidasUnit) {
          comidasUnit.textContent = summary.nutrition.mealsCount === 1 ? 'comida registrada' : 'comidas registradas';
        }

        if (saciedadBadge) {
          if (summary.nutrition.averageSatietyLevel != null) {
            saciedadBadge.className = 'satiety-badge';
            saciedadBadge.textContent = `Nivel ${summary.nutrition.averageSatietyLevel} — ${summary.nutrition.satietyDescription || 'Satisfecho'}`;
          } else {
            saciedadBadge.className = 'satiety-badge satiety-badge--empty';
            saciedadBadge.textContent = 'Sin nivel de saciedad registrado';
          }
        }

        if (pausasVal) {
          pausasVal.textContent = `${summary.nutrition.consciousPausesCount} de ${summary.nutrition.mealsCount}`;
        }
        if (repeticionVal) {
          repeticionVal.textContent = `${summary.nutrition.repeatedMealsCount} veces`;
        }
        if (alimentacionFooter) {
          alimentacionFooter.textContent = `${summary.nutrition.mealsCount} registro(s) completado(s) hoy`;
        }
      } else {
        // Estado real: Sin comidas registradas hoy
        if (comidasVal) comidasVal.textContent = '0';
        if (comidasUnit) comidasUnit.textContent = 'comidas registradas';
        if (saciedadBadge) {
          saciedadBadge.className = 'satiety-badge satiety-badge--empty';
          saciedadBadge.textContent = 'Sin registros de saciedad hoy';
        }
        if (pausasVal) pausasVal.textContent = '0 registradas';
        if (repeticionVal) repeticionVal.textContent = '0 veces';
        if (alimentacionFooter) {
          alimentacionFooter.textContent = 'Registra tu primera comida para comenzar el seguimiento';
        }
      }
    };

    // Consultar datos reales de dashboard desde el backend
    try {
      const summary = await dashboardService.getSummary(token);
      renderMetrics(summary);
    } catch (err) {
      console.warn('Error al obtener datos reales de dashboard:', err);
    }

    // Sincronizar usuario fresco de la API
    try {
      const freshUser = await authService.getMe(token);
      renderUserProfile(freshUser);
    } catch (err) {
      console.warn('No se pudo sincronizar usuario con el backend:', err);
    }

    // 3. Modal de registro de peso
    const weightModal = document.getElementById('weight-modal') as HTMLDialogElement | null;
    const weightForm = document.getElementById('weight-form') as HTMLFormElement | null;
    const weightInput = document.getElementById('input-weight-kg') as HTMLInputElement | null;
    const dateInput = document.getElementById('input-weight-date') as HTMLInputElement | null;
    const errorBanner = document.getElementById('weight-form-error');
    const submitBtn = document.getElementById('btn-submit-weight') as HTMLButtonElement | null;
    const submitBtnText = document.getElementById('btn-submit-weight-text');

    const openWeightModal = () => {
      if (!weightModal) return;
      if (errorBanner) {
        errorBanner.style.display = 'none';
        errorBanner.textContent = '';
      }
      if (weightInput) {
        weightInput.value = '';
      }
      if (dateInput) {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        dateInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
      }
      weightModal.showModal();
      setTimeout(() => weightInput?.focus(), 50);
    };

    const closeWeightModal = () => {
      if (weightModal && weightModal.open) {
        weightModal.close();
      }
    };

    document.getElementById('action-peso')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-add-weight-card')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-card-register-peso')?.addEventListener('click', openWeightModal);
    document.getElementById('btn-close-weight-modal')?.addEventListener('click', closeWeightModal);
    document.getElementById('btn-cancel-weight')?.addEventListener('click', closeWeightModal);

    weightModal?.addEventListener('click', (e) => {
      if (e.target === weightModal) closeWeightModal();
    });

    weightForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!weightInput) return;

      const rawVal = weightInput.value.trim();
      const weightVal = parseFloat(rawVal);

      if (isNaN(weightVal) || weightVal < 20.0 || weightVal > 350.0) {
        if (errorBanner) {
          errorBanner.textContent = 'Por favor introduce un peso válido entre 20.0 y 350.0 kg.';
          errorBanner.style.display = 'block';
        }
        weightInput.focus();
        return;
      }

      let occurredAt: string | undefined = undefined;
      if (dateInput && dateInput.value) {
        try {
          const parsedDate = new Date(dateInput.value);
          if (!isNaN(parsedDate.getTime())) {
            occurredAt = parsedDate.toISOString();
          }
        } catch {
          // Dejar undefined para que el backend asigne 'now'
        }
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Guardando...';
      if (errorBanner) errorBanner.style.display = 'none';

      try {
        await weightService.createWeight(
          {
            weightKg: Math.round(weightVal * 100) / 100,
            occurredAt,
          },
          token
        );

        showAuthNotification(`¡Medición de ${weightVal.toFixed(1)} kg guardada exitosamente!`, 'success');
        closeWeightModal();

        // Actualizar dashboard inmediatamente con la nueva medición
        const freshSummary = await dashboardService.getSummary(token);
        renderMetrics(freshSummary);
      } catch (err: unknown) {
        const errorMsg =
          err instanceof Error
            ? err.message
            : 'Error al registrar la medición de peso';

        if (errorBanner) {
          errorBanner.textContent = errorMsg;
          errorBanner.style.display = 'block';
        }
        showAuthNotification(errorMsg, 'error');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnText) submitBtnText.textContent = 'Guardar medición';
      }
    });

    // Otros botones de acción rápida
    document.getElementById('action-comida')?.addEventListener('click', () => {
      showAuthNotification('Módulo de registro de alimentación en desarrollo.', 'info');
    });
    document.getElementById('action-actividad')?.addEventListener('click', () => {
      showAuthNotification('Módulo de registro de actividad física en desarrollo.', 'info');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeDashboard);
  } else {
    initializeDashboard();
  }
</script>
