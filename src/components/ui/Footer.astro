---
import { getAppUrl } from '../../utils/paths';

const homeUrl = getAppUrl();
const privacyUrl = getAppUrl('privacidad');
const termsUrl = getAppUrl('terminos');
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-brand">
      <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M16 4 L24 12 L16 20 L8 12 Z" fill="var(--color-body)" opacity="0.9"/>
        <path d="M16 12 L24 20 L16 28 L8 20 Z" fill="var(--color-body)" opacity="0.45"/>
      </svg>
      <span class="body-sm text-body">Mejorándome</span>
    </div>
    <nav class="footer-links" aria-label="Pie de página">
      <a href={`${homeUrl}#funcionalidades`} class="caption text-mute">Funcionalidades</a>
      <a href={`${homeUrl}#como-funciona`} class="caption text-mute">Cómo funciona</a>
      <a href={privacyUrl} class="caption text-mute">Política de privacidad</a>
      <a href={termsUrl} class="caption text-mute">Condiciones del servicio</a>
    </nav>
    <p class="caption text-mute">
      Herramienta personal de seguimiento. No sustituye una evaluación médica profesional.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-3xl) var(--space-lg);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .footer-links a:hover {
    color: var(--color-ink);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  @media (min-width: 768px) {
    .footer {
      padding: var(--space-3xl) var(--space-xl);
    }

    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .footer {
      max-width: 1200px;
      margin: 0 auto;
    }
  }
</style>
