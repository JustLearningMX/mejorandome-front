---
import { getAppUrl } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Aplicación web para el seguimiento personal del peso, alimentación, saciedad y actividad física.',
} = Astro.props;

const faviconUrl = getAppUrl('favicon.svg');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2b2622" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Instrument+Serif:ital@1&family=Inter:wght@400;500&display=swap"
    />
    <title>{title} — Mejorándome</title>
    <script is:inline>
      try {
        const hasSession = localStorage.getItem('accessToken') && localStorage.getItem('user');
        document.documentElement.dataset.session = hasSession ? 'user' : 'guest';
      } catch {
        document.documentElement.dataset.session = 'guest';
      }
    </script>
    <!-- Google Identity Services -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
